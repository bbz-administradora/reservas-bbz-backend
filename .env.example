# Development Environment Template

# API Configuration
DOMAIN=".localhost"
API_URL="http://localhost"
API_PORT="5000"
API_DOC_USER="admin"
API_DOC_PASSWORD="password"
WEB_APP_URL="localhost"
WEB_APP_URL_PORT="3000"
WEB_ADM_APP_URL="localhost"
WEB_ADM_APP_URL_PORT="3001"
NODE_ENV="development"
EMAIL_CONTACT="your email contact here"
WHATSAPP_CONTACT="your whatsapp contact here"
ADDRESS="your address here"

# JWT Authentication
JWT_SECRET="your_jwt_secret_key_here"
PEPPER_PASSWORD="your_pepper_password_here"

# Developer Information
DEVELOPER_IP="http://localhost"
DEVELOPER_EMAIL="developer@example.com"
DEVELOPER_PASSWORD="password"
DEVELOPER_GITHUB="https://github.com/yourusername"
REPOSITORY_PROJECT_URL="https://github.com/yourusername/project"

# Database Configuration
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_HOST=localhost
POSTGRES_PORT=25432
POSTGRES_DB=bbz_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Email Configuration (optional)
EMAIL_HOST_USER="email that will send the email"
EMAIL_HOST_PASSWORD="password"
EMAIL_HOST_SMTP="smtp.gmail.com"
EMAIL_HOST_PORT="465"
EMAIL_CLIENT="email that will receive the email"
EMAIL_FROM="gestaobbzapp@bbz.com.br"

# Jobs agendados
# Quem agenda e o pg_cron do Supabase; a API so executa quando recebe o gatilho.
# JOBS_TRIGGER_SECRET e o MESMO valor guardado no Vault como jobs_trigger_secret.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JOBS_TRIGGER_SECRET="minimo de 32 caracteres - nunca commitar"
# Teto de execucao da plataforma, em ms. Depende do plano da Vercel.
JOBS_TIME_BUDGET_MS="50000"

# Storage
# Seleciona o adapter: "s3" (atual) ou "supabase" (destino da migração).
STORAGE_DRIVER="s3"

# AWS S3 Configuration (driver "s3")
PUBLIC_BUCKET="https://your-public-bucket.s3.us-east-1.amazonaws.com"
S3_REGION="us-east-1"
S3_ACCESS_KEY="s3 access key"
S3_SECRET_KEY="s3 secret key"

# Supabase Storage (driver "supabase") - obrigatórias quando STORAGE_DRIVER=supabase
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service role key - nunca commitar"
SUPABASE_STORAGE_BUCKET="reservas-assets"

# Base pública dos assets estáticos (ícones de e-mail, SVG de 404, OG), servidos
# pelo próprio bucket. Mesmo valor de NEXT_PUBLIC_BUCKET no front. Sem barra no final.
ASSETS_BASE_URL="https://your-project-ref.supabase.co/storage/v1/object/public/reservas-assets"

# google cloud Oauth
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URI="http://localhost:5000/v1/public/auth/login/google/callback"

# social media
FACEBOOK_URL="https://www.facebook.com/yourcompany"
INSTAGRAM_URL="https://www.instagram.com/yourcompany"
LINKEDIN_URL="https://www.linkedin.com/company/yourcompany"
YOUTUBE_URL="https://www.youtube.com/yourchannel"

# DLOCK API Configuration
DLOCK_CLIENT_ID="your_dlock_client_id_here"
DLOCK_CLIENT_SECRET="your_dlock_client_secret_here"
DLOCK_API_URL="https://api.dlock.com"
DLOCK_USERNAME="your_dlock_username_here"
DLOCK_PASSWORD="your_dlock_password_here"

{
  "name": "bbz-app-backend",
  "version": "2.0.0",
  "description": "BBZ App Backend API",
  "main": "build/server.js",
  "license": "UNLICENSED",
  "author": "BBZ",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:docker": "NODE_ENV=development npm run tailwind:generate && npm run services:up && npm run wait-for-postgres && npm run migration:up && npm run seed && tsx watch src/server.ts",
    "build": "tsup src !src/infra/compose.yaml --out-dir build --minify",
    "start": "NODE_ENV=production node build/server.js",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint:eslint:check": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "services:up": "docker compose -f src/infra/compose.yaml up -d",
    "services:logs": "docker compose -f src/infra/compose.yaml logs -f",
    "services:stop": "docker compose -f src/infra/compose.yaml stop",
    "services:down": "docker compose -f src/infra/compose.yaml down",
    "migration:create": "node-pg-migrate --migrations-dir src/infra/migrations create",
    "migration:up": "node-pg-migrate --migrations-dir src/infra/migrations --envPath .env up",
    "seed": "tsx src/infra/scripts/seed.ts",
    "wait-for-postgres": "tsx src/infra/scripts/wait-for-postgres.ts",
    "tailwind:generate": "npx tailwindcss -i ./src/lib/tailwind/styles/globals.css -o ./src/lib/tailwind/styles/tailwind-email.generated.css",
    "tailwind:generate:watch": "npx tailwindcss -i ./src/lib/tailwind/styles/globals.css -o ./src/lib/tailwind/styles/tailwind-email.generated.css --watch"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.803.0",
    "@fastify/basic-auth": "^6.2.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/request-context": "^6.2.0",
    "@fastify/schedule": "^6.0.0",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@react-email/components": "^1.0.0",
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^3.0.2",
    "croner": "^9.1.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.5.0",
    "dotenv-expand": "^12.0.2",
    "fast-jwt": "^6.3.2",
    "fastify": "^5.3.2",
    "fastify-type-provider-zod": "^4.0.2",
    "googleapis": "^178.0.0",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^9.1.0",
    "p-limit": "^6.2.0",
    "pg": "^8.15.6",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.17",
    "toad-scheduler": "^3.1.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "uuid": "^11.1.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.12",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.12.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.3",
    "eslint": "^9.26.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
  }
}
